# Copy to .env and edit. Real environment variables always override this file.

# --- Core ---------------------------------------------------------------
# Local development: set to 1. Production MUST be 0.
DJANGO_DEBUG=1
# Leave empty to auto-generate a per-install key stored in .secret_key,
# or set an explicit value (required for multi-node deployments).
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production-only hardening (ignored when DJANGO_DEBUG=1)
DJANGO_SECURE_COOKIES=1
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
# Set to 1 ONLY behind a trusted reverse proxy (enables X-Forwarded-For/Proto)
TRACEX_TRUST_PROXY=0

# --- Accounts -----------------------------------------------------------
TRACEX_ALLOW_SIGNUP=0
TRACEX_LOGIN_MAX_ATTEMPTS=5
TRACEX_LOGIN_WINDOW_SECONDS=900

# --- Database (sqlite by default; postgres supported) -------------------
TRACEX_DB_ENGINE=sqlite
# TRACEX_SQLITE_PATH=/var/lib/tracex/db.sqlite3
# TRACEX_DB_ENGINE=postgres
# POSTGRES_DB=tracex
# POSTGRES_USER=tracex
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# TRACEX_MEDIA_ROOT=/var/lib/tracex/media

# --- Optional external reputation (leave empty = local analysis only) ---
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# --- Sentinel AI (server-side only; keys never reach the browser) -------
# deterministic = no external calls (default). gemini / openai need a key.
SENTINEL_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
